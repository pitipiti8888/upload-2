  let i = await j('POST', '/api/uploads', meta); if (i._s !== 200) throw new Error(i.error);
  const put = (off, end) => fetch(`${B}/api/uploads/${i.id}?offset=${off}`, { method: 'PUT', body: buf.subarray(off, end) });
  if (cut) { await put(0, cut); i = await j('POST', '/api/uploads', meta); ok(i.offset === cut, 'upload interrompido e retomado do byte certo', `offset ${i.offset}`); }
  let off = i.offset || 0; while (off < buf.length) { const e = Math.min(off + chunk, buf.length), r = await put(off, e); if (r.status !== 200) throw new Error('PUT ' + r.status); off = e; }
